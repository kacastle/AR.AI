# false (default): the real backend (backend/API_CONTRACT.md) at VITE_API_BASE_URL. See src/api.js.
# true: offline demo data from src/mocks/api.js, no server needed (no diagnostic, no saved progress).
VITE_USE_MOCK=false
# Empty: same origin through the Vite /api proxy (vite.config.js -> http://127.0.0.1:8000, override with BACKEND_URL).
VITE_API_BASE_URL=

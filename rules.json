  "mistake_types": {
    "P_SUB_VOWEL": {
      "group": "phonological",
      "description_en": "Wrong vowel, often e/i or o/u",
      "method": "minimal_pair_vowels"
    },
    "P_SUB_CONS": {
      "group": "phonological",
      "description_en": "Wrong consonant, often b/d, p/b, m/n",
      "method": "minimal_pair_consonants"
    },
    "P_OMIT_FINAL": {
      "group": "phonological",
      "description_en": "Final consonant left out",
      "method": "syllable_color_clap"
    },
    "P_OMIT_MID": {
      "group": "phonological",
      "description_en": "Middle consonant left out (closed syllable or cluster)",
      "method": "syllable_tiles_then_letters"
    },
    "P_ADD": {
      "group": "phonological",
      "description_en": "Extra letter",
      "method": "count_slots"
    },
    "O_ORDER": {
      "group": "orthographic",
      "description_en": "Correct letters in the wrong order",
      "method": "left_to_right_highlight"
    },
    "O_NG": {
      "group": "orthographic",
      "description_en": "ng written as n, or as n + g",
      "method": "ng_sound_pairs"
    },
    "S_SYLL_MISS": {
      "group": "syllable",
      "description_en": "A whole syllable left out",
      "method": "clap_count_syllables"
    },
    "SN_ORDER": {
      "group": "sentence",
      "description_en": "Words in the wrong order",
      "method": "first_word_model_sentence"
    },
    "SN_PUNCT": {
      "group": "sentence",
      "description_en": "Capital letter or period missing",
      "method": "capital_period_rule"
    },
    "C_LITERAL": {
      "group": "comprehension",
      "description_en": "Wrong who, where, or what answer",
      "method": "highlight_answer_sentence"
    },
    "C_SEQUENCE": {
      "group": "comprehension",
      "description_en": "Wrong story order",
      "method": "picture_order_strip"
    },
    "C_INFER": {
      "group": "comprehension",
      "description_en": "Wrong feeling or main idea",
      "method": "hint_question"
    },
    "SLOW": {
      "group": "engagement",
      "description_en": "No answer after slow_seconds, or 2+ hints",
      "method": "easier_item_encourage"
    }
  },
  "methods": {
    "minimal_pair_vowels": {
      "description_en": "Play the correct word and the wrong-vowel word as a pair. Then 3 items that use only the two vowel tiles.",
      "items_after": 3
    },
    "minimal_pair_consonants": {
      "description_en": "Show a picture card for each of the two sounds. Then dictation with only the two confused letters.",
      "items_after": 3
    },
    "syllable_color_clap": {
      "description_en": "Split the word into colored syllables and clap each one. Focus on the last sound.",
      "items_after": 3
    },
    "syllable_tiles_then_letters": {
      "description_en": "Build the word with syllable tiles first, then with letter tiles. TTS says each syllable slowly.",
      "items_after": 2
    },
    "count_slots": {
      "description_en": "Show the number of empty slots. Count the sounds together.",
      "items_after": 2
    },
    "left_to_right_highlight": {
      "description_en": "Highlight each letter left to right while TTS speaks. Build one syllable at a time.",
      "items_after": 2
    },
    "ng_sound_pairs": {
      "description_en": "Show the ng sound card. Play pairs: na/nga, ni/ngi. Highlight the ng tile.",
      "items_after": 3
    },
    "clap_count_syllables": {
      "description_en": "Clap and count the syllables. Use syllable tiles.",
      "items_after": 2
    },
    "first_word_model_sentence": {
      "description_en": "Show the first word (capital letter). TTS reads the model sentence. Retry.",
      "items_after": 1
    },
    "capital_period_rule": {
      "description_en": "Highlight the capital letter and the period.",
      "items_after": 1
    },
    "highlight_answer_sentence": {
      "description_en": "Highlight the sentence that has the answer. TTS reads it. Retry.",
      "items_after": 1
    },
    "picture_order_strip": {
      "description_en": "Put a picture strip of 3 events in order. Then a shorter story.",
      "items_after": 1
    },
    "hint_question": {
      "description_en": "Ask a hint question about what happened before. Retry.",
      "items_after": 1
    },
    "easier_item_encourage": {
      "description_en": "Encourage. Give an easier item from the same skill.",
      "items_after": 1
    }
  },
